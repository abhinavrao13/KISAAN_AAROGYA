# ==========================================
# KisanArogya AI - Environment Configuration
# ==========================================

# --- Backend Configuration ---
ENVIRONMENT=production
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Database URL:
# For production PostgreSQL (Railway / Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:port/database
# For local development (leave empty to use default local SQLite):
DATABASE_URL=

# Optional model path override:
# MODEL_PATH=app/ml/model_weights.pth

# --- Frontend Configuration ---
# Set to your deployed backend URL on Vercel:
# VITE_API_URL=https://your-backend-service.onrender.com
VITE_API_URL=
